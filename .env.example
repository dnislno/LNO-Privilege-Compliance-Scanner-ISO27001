# LNO Privilege Compliance Scanner — Environment Configuration
# Copy this file to .env and fill in values (DO NOT commit .env)

# Optional: Set a token to protect POST /api/scan/trigger from unauthorized access
# Default: "scan_trigger" (printed on server start). Set via env var or .env file.
SCAN_TOKEN=

# Optional: Dashboard Basic Authentication
# Set both DASHBOARD_USER and DASHBOARD_PASS to enable Basic auth for the web dashboard.
# If enabled, all routes (including API) require authentication via browser login prompt.
DASHBOARD_USER=
DASHBOARD_PASS=

# Optional: API Key for programmatic access to API endpoints
# If set, all API requests require X-API-Key header matching this value.
# Alternative to Basic auth for script/automation access.
API_KEY=

# Optional: Rate limit in requests per minute per IP. Default: 100. Set to 0 to disable.
RATE_LIMIT=

# Optional: Delete scan.db from disk after loading into memory.
# Default: DISABLED (file kept on disk so data survives server restart).
# Enable only if your compliance policy requires zero data at rest.
# WARNING: If the server restarts, all scan data is permanently lost.
DELETE_DB_ON_LOAD=
